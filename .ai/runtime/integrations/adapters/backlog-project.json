{
  "schema_version": "1.0.0",
  "id": "backlog-project-adapter",
  "category": "backlog-project",
  "authority": "read-only-default",
  "operations": [
    "discover",
    "read",
    "query",
    "create-draft",
    "validate",
    "propose-change",
    "execute-approved-change",
    "verify",
    "rollback"
  ],
  "audit": {
    "execution_record_required": true,
    "external_call_record_required": true
  },
  "mutation_policy": {
    "default": "deny",
    "requires": [
      "explicit-approval",
      "scope-match",
      "change-digest-match"
    ],
    "postconditions": [
      "verification",
      "immutable-audit-event"
    ]
  }
}
