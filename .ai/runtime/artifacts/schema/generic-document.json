{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "owner",
    "source",
    "basis",
    "acceptance_gates"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis": {
      "enum": [
        "stated",
        "inferred",
        "assumed"
      ]
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
