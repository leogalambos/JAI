{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jai/content/document-content-spec/1.0.0",
  "title": "Proposed JAI DCS foundation specification",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "completeness",
    "inherits",
    "purpose",
    "applies_to",
    "required_information",
    "conditional_information",
    "optional_information",
    "forbidden_information",
    "size_budget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "deprecated"
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "skeleton"
      ]
    },
    "inherits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "object"
    },
    "size_budget": {
      "type": "object",
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "enum": [
            "pages",
            "words",
            "slides",
            "rows",
            "elements",
            "typed",
          "semantic_units",
            "not-applicable"
          ]
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "soft_max": {
          "type": "number",
          "minimum": 0
        },
        "hard_max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_unit"
      }
    },
    "conditional_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_unit"
      }
    },
    "optional_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_unit"
      }
    },
    "forbidden_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_unit"
      }
    },
    "low_value_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_unit"
      }
    }
  },
  "$defs": {
    "information_unit": {
      "type": "object",
      "required": [
        "id",
        "semantic_fields",
        "datatype",
        "obligation",
        "acceptance_predicate",
        "evidence_policy",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "datatype": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "reference",
            "any"
          ]
        },
        "obligation": {
          "enum": [
            "MUST",
            "MAY",
            "MUST NOT",
            "CONDITIONAL",
            "SHOULD NOT"
          ]
        },
        "when": {
          "type": "object",
          "required": [
            "field",
            "op"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "in",
                "present"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        },
        "acceptance_predicate": {
          "type": "object",
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "enum": [
                "nonempty",
                "evidence",
                "review"
              ]
            }
          },
          "additionalProperties": false
        },
        "evidence_policy": {
          "type": "object"
        },
        "rationale": {
          "type": "object",
          "required": [
            "basis",
            "reason",
            "source_refs"
          ],
          "properties": {
            "basis": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
