{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagram Model",
  "type": "object",
  "required": [
    "title",
    "nodes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "architecture",
        "process",
        "trust-boundary",
        "roadmap",
        "relationship"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
