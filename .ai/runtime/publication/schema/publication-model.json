{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Publication Model",
  "type": "object",
  "required": [
    "title",
    "artifact_id",
    "audience",
    "owner",
    "classification",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "decision_supported": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "stated",
              "inferred",
              "assumed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "type": "object"
          },
          "diagram": {
            "type": "object"
          }
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
