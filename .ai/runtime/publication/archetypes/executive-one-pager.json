{
  "id": "executive-one-pager",
  "version": "2.0.0",
  "audience": [
    "executive"
  ],
  "max_detail": "executive",
  "mandatory_sections": [
    "Decision / ask",
    "Business context",
    "Recommendation",
    "Value and risk",
    "Next actions"
  ],
  "mandatory_semantic_fields": [
    "claims",
    "decisions",
    "risks",
    "owner",
    "classification"
  ],
  "formats": [
    "docx",
    "html",
    "pdf"
  ],
  "supported_diagrams": [
    "architecture",
    "flow",
    "roadmap",
    "risk",
    "dependency"
  ],
  "table_types": [
    "decision",
    "risk",
    "traceability",
    "action",
    "inventory"
  ],
  "executive_summary": {
    "required": true,
    "max_words": 300
  },
  "document_control": {
    "required": true
  },
  "classification": {
    "required": true
  },
  "approval_block": {
    "required": true
  },
  "branding": {
    "theme": "enterprise-default"
  },
  "accessibility": {
    "min_font_pt": 10,
    "require_alt_text_for_meaningful_images": true
  }
}
