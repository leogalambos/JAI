{
  "id": "migration-cutover-pack",
  "version": "2.0.0",
  "audience": [
    "programme",
    "engineering",
    "operations"
  ],
  "max_detail": "operational",
  "mandatory_sections": [
    "Scope",
    "Migration plan",
    "Cutover plan",
    "Dependencies",
    "Readiness",
    "Rollback",
    "Go / no-go",
    "Validation"
  ],
  "mandatory_semantic_fields": [
    "claims",
    "decisions",
    "risks",
    "evidence",
    "traceability"
  ],
  "formats": [
    "docx",
    "xlsx",
    "pptx",
    "html"
  ],
  "supported_diagrams": [
    "architecture",
    "flow",
    "roadmap",
    "risk",
    "dependency"
  ],
  "table_types": [
    "decision",
    "risk",
    "traceability",
    "action",
    "inventory"
  ],
  "executive_summary": {
    "required": true,
    "max_words": 300
  },
  "document_control": {
    "required": true
  },
  "classification": {
    "required": true
  },
  "approval_block": {
    "required": true
  },
  "branding": {
    "theme": "enterprise-default"
  },
  "accessibility": {
    "min_font_pt": 10,
    "require_alt_text_for_meaningful_images": true
  }
}
