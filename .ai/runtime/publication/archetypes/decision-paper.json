{
  "id": "decision-paper",
  "version": "2.0.0",
  "audience": [
    "decision authority"
  ],
  "max_detail": "decision",
  "mandatory_sections": [
    "Decision required",
    "Context",
    "Options considered",
    "Recommendation and rationale",
    "Risks and mitigations",
    "Decision record"
  ],
  "mandatory_semantic_fields": [
    "claims",
    "decisions",
    "evidence",
    "risks",
    "owner"
  ],
  "formats": [
    "docx",
    "html",
    "pdf"
  ],
  "supported_diagrams": [
    "architecture",
    "flow",
    "roadmap",
    "risk",
    "dependency"
  ],
  "table_types": [
    "decision",
    "risk",
    "traceability",
    "action",
    "inventory"
  ],
  "executive_summary": {
    "required": true,
    "max_words": 300
  },
  "document_control": {
    "required": true
  },
  "classification": {
    "required": true
  },
  "approval_block": {
    "required": true
  },
  "branding": {
    "theme": "enterprise-default"
  },
  "accessibility": {
    "min_font_pt": 10,
    "require_alt_text_for_meaningful_images": true
  }
}
