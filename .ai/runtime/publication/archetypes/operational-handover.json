{
  "id": "operational-handover",
  "version": "2.0.0",
  "audience": [
    "operations",
    "service management"
  ],
  "max_detail": "operational",
  "mandatory_sections": [
    "Service overview",
    "Support model",
    "Monitoring",
    "Runbooks",
    "Continuity",
    "Known risks",
    "Acceptance"
  ],
  "mandatory_semantic_fields": [
    "claims",
    "evidence",
    "risks",
    "approvals",
    "owner"
  ],
  "formats": [
    "docx",
    "xlsx",
    "html"
  ],
  "supported_diagrams": [
    "architecture",
    "flow",
    "roadmap",
    "risk",
    "dependency"
  ],
  "table_types": [
    "decision",
    "risk",
    "traceability",
    "action",
    "inventory"
  ],
  "executive_summary": {
    "required": true,
    "max_words": 300
  },
  "document_control": {
    "required": true
  },
  "classification": {
    "required": true
  },
  "approval_block": {
    "required": true
  },
  "branding": {
    "theme": "enterprise-default"
  },
  "accessibility": {
    "min_font_pt": 10,
    "require_alt_text_for_meaningful_images": true
  }
}
