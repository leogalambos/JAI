{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual professional semantic return, before structural encoding",
  "type": "object",
  "properties": {
    "format": {
      "const": "jai.semantic-return/1"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/selection"
          },
          {
            "$ref": "#/$defs/author"
          },
          {
            "$ref": "#/$defs/integrator"
          },
          {
            "$ref": "#/$defs/measurement"
          },
          {
            "$ref": "#/$defs/reviewer"
          },
          {
            "$ref": "#/$defs/integration_reviewer"
          },
          {
            "$ref": "#/$defs/receiver"
          },
          {
            "$ref": "#/$defs/setter"
          },
          {
            "$ref": "#/$defs/owner_action"
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "results"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/reference"
        },
        {
          "type": "object",
          "properties": {
            "alias": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "alias"
          ],
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "selection"
        },
        "specialties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "workload_class": {
          "type": "string",
          "minLength": 1
        },
        "model_selector": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/reference"
                },
                {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "alias"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "member",
        "kind",
        "specialties",
        "provider",
        "workload_class",
        "model_selector",
        "reason"
      ],
      "additionalProperties": false
    },
    "author": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "author"
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true,
          "description": "References to additional observation products that must be qualified before use. Do not cite request, criteria, assignment or other source records here. Ordinary document-derived work uses []; its input and criteria provenance is already bound by the host. Source citations may remain in the actual material."
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "materials",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "integrator": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "integrator"
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "related": {
          "$ref": "#/$defs/relationships"
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "materials",
        "answers",
        "related",
        "limitations"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "measurement"
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true,
          "description": "References to additional observation products that must be qualified before use. Do not cite request, criteria, assignment or other source records here. Ordinary document-derived work uses []; its input and criteria provenance is already bound by the host. Source citations may remain in the actual material."
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "materials",
        "inputs",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "reviewer"
        },
        "verdict": {
          "enum": [
            "supported",
            "supported_with_conditions",
            "rework_required",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reference"
              },
              {
                "$ref": "#/$defs/finding"
              }
            ]
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "verdict",
        "findings",
        "conditions",
        "rationale"
      ],
      "additionalProperties": false
    },
    "integration_reviewer": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "integration_reviewer"
        },
        "verdict": {
          "enum": [
            "supported",
            "supported_with_conditions",
            "rework_required",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reference"
              },
              {
                "$ref": "#/$defs/finding"
              }
            ]
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "verdict",
        "findings",
        "conditions",
        "rationale"
      ],
      "additionalProperties": false
    },
    "receiver": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "receiver"
        },
        "verdict": {
          "enum": [
            "accepted",
            "information_required",
            "change_required"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reference"
              },
              {
                "$ref": "#/$defs/finding"
              }
            ]
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "verdict",
        "findings",
        "conditions",
        "rationale"
      ],
      "additionalProperties": false
    },
    "setter": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "setter"
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "oneOf": [
                  {
                    "$ref": "common.schema.json#/$defs/reference"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "alias": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "alias"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_slots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "Additional named prerequisites requiring separately qualified observation products. Use [] when the criterion is checked by inspecting the assigned candidate and its ordinary independent review. Do not list the answer slot, candidate reference, review target or review/proof slot here; those do not supply an observation binding."
              }
            },
            "required": [
              "id",
              "requirement",
              "statement",
              "evidence_slots"
            ],
            "additionalProperties": false
          }
        },
        "inherited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "procedure": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "question",
                "layer"
              ]
            },
            "specification": {
              "type": "object"
            },
            "previous": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/reference"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "alias": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "alias"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "specification",
            "reason"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "question"
                  }
                }
              },
              "then": {
                "properties": {
                  "specification": {
                    "$ref": "decision.schema.json#/$defs/question_procedure"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "layer"
                  }
                }
              },
              "then": {
                "properties": {
                  "specification": {
                    "$ref": "decision.schema.json#/$defs/layer_procedure"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "member",
        "logical_id",
        "kind",
        "materials",
        "criteria",
        "inherited",
        "procedure"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "json": {}
            },
            "required": [
              "json"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "blob"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "slot_id",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "finding": {
      "type": "object",
      "properties": {
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true,
          "description": "References to additional observation products that must be qualified before use. Do not cite request, criteria, assignment or other source records here. Ordinary document-derived work uses []; its input and criteria provenance is already bound by the host. Source citations may remain in the actual material."
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      },
      "required": [
        "logical_id",
        "criterion",
        "observation",
        "materials",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "format": {
          "const": "jai.semantic-return/1"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "member"
            ]
          }
        }
      },
      "required": [
        "format",
        "results"
      ],
      "additionalProperties": false
    },
    "owned_criteria": {
      "type": "object",
      "properties": {
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "materials": {
          "$ref": "#/$defs/materials"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "oneOf": [
                  {
                    "$ref": "common.schema.json#/$defs/reference"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "alias": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "alias"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_slots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "Additional named prerequisites requiring separately qualified observation products. Use [] when the criterion is checked by inspecting the assigned candidate and its ordinary independent review. Do not list the answer slot, candidate reference, review target or review/proof slot here; those do not supply an observation binding."
              }
            },
            "required": [
              "id",
              "requirement",
              "statement",
              "evidence_slots"
            ],
            "additionalProperties": false
          }
        },
        "inherited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "logical_id",
        "materials",
        "criteria",
        "inherited"
      ],
      "additionalProperties": false
    },
    "owner_action": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "owner_action"
        },
        "decision": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "invalidate",
                "reformulate",
                "reinstate",
                "resolve_escalation",
                "rework",
                "select",
                "terminate"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "assignment": {},
            "replacement": {},
            "findings": {},
            "subject": {},
            "slot": {},
            "candidate": {},
            "previous": {},
            "subjects": {},
            "fresh_proofs": {},
            "escalation": {},
            "package": {},
            "conflicts": {},
            "impacts": {},
            "decisions": {}
          },
          "required": [
            "action",
            "reason"
          ],
          "additionalProperties": false
        },
        "criteria_source": {
          "$ref": "#/$defs/owned_criteria"
        }
      },
      "required": [
        "member",
        "kind",
        "decision"
      ],
      "additionalProperties": false,
      "description": "The selected ordinary decision is checked against its canonical action-specific schema after structural reference encoding; the host supplies no professional decision."
    }
  }
}
