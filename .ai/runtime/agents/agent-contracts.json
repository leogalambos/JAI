  "version": "2.1.0",
  "contracts": [
    {
      "id": "codebase-reviewer",
      "purpose": "codebase-reviewer authority boundary",
      "provider": "provider-neutral",
      "authority_boundary": "read-only-review",
      "skills": [],
      "permissions": {
        "filesystem": [
          "read:workspace"
        ],
        "shell": [
          "read-only"
        ],
        "network": [
          "provider-managed"
        ],
        "git": [
          "read"
        ],
        "mcp": [
          "allowlisted"
        ]
      },
      "allowed_tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash"
      ],
      "denied_tools": [
        "Write",
        "Edit"
      ],
      "sandbox": {
        "mode": "read-only",
        "workspace_write": false,
        "network": "provider-managed"
      },
      "mutation_allowed": false,
      "escalation": "human approval",
      "approval_required_for": [
        "policy-change",
        "release-approval"
      ],
      "audit_level": "high",
      "workload_class": "standard",
      "jai": {
        "core_version": "1.0.0",
        "layer": 3,
        "layer_name": "Reasoning, Policy and Control",
        "profile": "runtime",
        "responsibility": "codebase-reviewer authority boundary",
        "input_refs": [
          "policy:managed-policy"
        ],
        "output_refs": [
          "execution:agent:codebase-reviewer"
        ],
        "authority_ref": "human-authority:read-only-review",
        "acceptance_question": "Are decisions, policy constraints, evidence obligations, trade-offs and escalation rules justified?",
        "evidence_obligations": [
          "ExecutionRecord"
        ]
      }
    },
