{
  "id": "ai-solution-approval",
  "scenario": "AI solution approval",
  "description": "Golden enterprise scenario for ai solution approval with cross-role enterprise delivery expectations.",
  "tags": [
    "AI governance",
    "data",
    "risk",
    "architecture"
  ],
  "inputs": {
    "case_prompt": "Assess and deliver an enterprise-grade ai solution approval outcome. Preserve evidence, authority, traceability and publication quality.",
