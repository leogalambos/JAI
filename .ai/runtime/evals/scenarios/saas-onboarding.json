  "description": "Golden enterprise scenario for saas onboarding with cross-role enterprise delivery expectations.",
  "tags": [
    "procurement",
    "security",
    "privacy",
    "architecture"
  ],
  "inputs": {
    "case_prompt": "Assess and deliver an enterprise-grade saas onboarding outcome. Preserve evidence, authority, traceability and publication quality.",
