      "vendor-manager",
      "third-party-risk-manager",
      "enterprise-applications-architect",
      "privacy-architect",
      "service-transition-and-operational-readiness-manager"
    ],
    "critical_requirements": [
      {
        "id": "REQ-02-1",
        "text": "Business capability and requirements are explicit before product selection"
      },
      {
        "id": "REQ-02-2",
        "text": "Supplier security/privacy/resilience evidence is assessed"
      },
      {
        "id": "REQ-02-3",
        "text": "Contract clauses make mandatory controls measurable and enforceable"
      },
      {
        "id": "REQ-02-4",
        "text": "Service acceptance includes support, ownership, monitoring and exit"
      }
    ],
    "critical_evidence": [
      "EV-02-1",
      "EV-02-2",
      "EV-02-3",
      "EV-02-4"
    ],
    "mandatory_artifacts": [
      "Supplier assessment",
      "Architecture-fit decision",
      "Contract control schedule",
      "Service acceptance"
    ],
    "traceability_links": [
      "TR-02-1",
      "TR-02-2",
      "TR-02-3",
      "TR-02-4"
    ],
    "decision_rationale": {
