{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/contracts/auto-release-policy-v2.schema.json",
  "title": "ReleasePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_policy_version",
    "production",
    "first_production_release",
    "version_scheme",
    "version_regex",
    "changelog_mode",
    "pre_ga_versions_in_changelog",
    "required_gates",
    "required_release_files",
    "signing"
  ],
  "properties": {
    "release_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "production": {
      "const": true
    },
    "first_production_release": {
      "type": "string",
      "minLength": 1
    },
    "version_scheme": {
      "const": "YY.MM.VV"
    },
    "version_regex": {
      "type": "string",
      "minLength": 1
    },
    "changelog_mode": {
      "const": "production-only"
    },
    "pre_ga_versions_in_changelog": {
      "const": false
    },
    "required_gates": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_release_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "private_key_in_package",
        "publication_requires_manual_approval",
        "attestation"
      ],
      "properties": {
        "mode": {
          "const": "automated-ci-release"
        },
        "private_key_in_package": {
          "const": false
        },
        "publication_requires_manual_approval": {
          "const": false
        },
        "attestation": {
          "enum": [
            "github-oidc-if-supported",
            "none"
          ]
        }
      }
    }
  }
}
