{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/contracts/native-write-policy-v1.schema.json",
  "title": "NativeWritePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "release",
    "unified_model",
    "native_write",
    "legacy_read_only",
    "rules"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "release": {
      "type": "string",
      "pattern": "^\\d{2}\\.(?:0[1-9]|1[0-2])\\.\\d+$",
      "description": "Historical model baseline; does not track package releases."
    },
    "unified_model": {
      "const": "JAI-six-layer-core"
    },
    "native_write": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "legacy_read_only": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "purpose": {
            "enum": [
              "read",
              "migration-fixture",
              "compatibility-fixture"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_write_requires_jai",
        "legacy_write_forbidden",
        "migration_outputs_native",
        "generated_registries_native",
        "profile_native_domain_writes",
        "behavioral_fixture_claims_forbidden"
      ],
      "properties": {
        "production_write_requires_jai": {
          "const": true
        },
        "legacy_write_forbidden": {
          "const": true
        },
        "migration_outputs_native": {
          "const": true
        },
        "generated_registries_native": {
          "const": true
        },
        "profile_native_domain_writes": {
          "const": true
        },
        "behavioral_fixture_claims_forbidden": {
          "const": true
        }
      }
    }
  }
}
