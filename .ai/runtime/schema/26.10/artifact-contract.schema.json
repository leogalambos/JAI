{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10/artifact-contract.schema.json",
  "title": "AI IT House Artifact Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "owner_role",
    "role_slug",
    "deliverable_number",
    "source_fingerprint",
    "artifact_type",
    "purpose",
    "audience",
    "decision_supported",
    "schema_ref",
    "required_inputs",
    "required_evidence",
    "required_relations",
    "mandatory_sections",
    "producer",
    "reviewers",
    "approver",
    "renderer",
    "output_formats",
    "publication_profile",
    "acceptance_profile",
    "evidence_profile",
    "system_of_record",
    "external_handoff_adapter",
    "classification",
    "lifecycle",
    "retention",
    "traceability",
    "production_mode",
    "semantic_gate",
    "publication_gate",
    "repository_gate",
    "portfolio_traceability",
    "classification_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*:[1-9][0-9]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "role_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "deliverable_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_supported": {
      "type": "string",
      "minLength": 1
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mandatory_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "output_formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication_profile": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_profile": {
      "type": "string",
      "minLength": 1
    },
    "evidence_profile": {
      "type": "string",
      "minLength": 1
    },
    "system_of_record": {
      "type": "string",
      "minLength": 1
    },
    "external_handoff_adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "review_cycle",
        "version"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "review_cycle": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "retention": {
      "type": "string",
      "minLength": 1
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "downstream"
      ],
      "properties": {
        "upstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "production_mode": {
      "enum": [
        "internal",
        "external_handoff"
      ]
    },
    "semantic_gate": {
      "type": "string",
      "minLength": 1
    },
    "publication_gate": {
      "type": "string",
      "minLength": 1
    },
    "repository_gate": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_traceability": {
      "type": "string",
      "minLength": 1
    },
    "classification_source": {
      "type": "string",
      "pattern": "^explicit-ga-[0-9]{2}\\.(0[1-9]|1[0-2])\\.[0-9]+$"
    }
  }
}
