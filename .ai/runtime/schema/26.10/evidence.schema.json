{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "captured_at",
    "integrity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "enum": [
        "observed",
        "provided",
        "generated",
        "verified"
      ]
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
