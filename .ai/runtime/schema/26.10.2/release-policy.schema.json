{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.2/release-policy.schema.json",
  "title": "ReleasePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_policy_version",
    "production",
    "first_production_release",
    "version_scheme",
    "version_regex",
    "changelog_mode",
    "pre_ga_versions_in_changelog",
    "required_gates",
    "required_release_files",
    "signing"
  ],
  "properties": {
    "release_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "production": {
      "const": true
    },
    "first_production_release": {
      "type": "string",
      "minLength": 1
    },
    "version_scheme": {
      "const": "YY.MM.VV"
    },
    "version_regex": {
      "type": "string",
      "minLength": 1
    },
    "changelog_mode": {
      "const": "production-only"
    },
    "pre_ga_versions_in_changelog": {
      "const": false
    },
    "required_gates": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_release_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "algorithm_family",
        "implementation",
        "build_generates_signature",
        "private_key_in_package",
        "sign_target",
        "signature_extension",
        "publication_requires_signature"
      ],
      "properties": {
        "mode": {
          "const": "external-release-owner"
        },
        "algorithm_family": {
          "const": "OpenPGP"
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "build_generates_signature": {
          "const": false
        },
        "private_key_in_package": {
          "const": false
        },
        "sign_target": {
          "const": "distribution SHA-256 checksum manifest"
        },
        "signature_extension": {
          "const": ".asc"
        },
        "publication_requires_signature": {
          "const": true
        }
      }
    }
  }
}
