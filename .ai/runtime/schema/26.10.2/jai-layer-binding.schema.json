{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.2/jai-layer-binding.schema.json",
  "title": "JAILayerBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core_version",
    "layer",
    "layer_name",
    "profile",
    "responsibility",
    "input_refs",
    "output_refs",
    "authority_ref",
    "acceptance_question"
  ],
  "properties": {
    "core_version": {
      "const": "1.0.0"
    },
    "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "layer_name": {
      "enum": [
        "Intent and Context",
        "Meaning and Domain Model",
        "Reasoning, Policy and Control",
        "Solution Design",
        "Realisation and Tooling",
        "Execution and Evidence"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_question": {
      "type": "string",
      "minLength": 1
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_layer",
        "to_layer",
        "contract_ref"
      ],
      "properties": {
        "from_layer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "to_layer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
