{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.2/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "owner",
    "rationale",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
