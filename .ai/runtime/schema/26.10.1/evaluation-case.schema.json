{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.1/evaluation-case.schema.json",
  "title": "BehavioralEvaluationCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scenario",
    "description",
    "tags",
    "inputs",
    "expected",
    "metrics",
    "threshold_profile"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "scenario": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_prompt",
        "constraints"
      ],
      "properties": {
        "case_prompt": {
          "type": "string",
          "minLength": 10
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_routes",
        "roles",
        "critical_requirements",
        "critical_evidence",
        "mandatory_artifacts",
        "traceability_links",
        "decision_rationale",
        "seeded_reviewer_defects"
      ],
      "properties": {
        "workflow_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "critical_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "critical_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mandatory_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "traceability_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "decision_rationale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alternatives_min",
            "required_fields"
          ],
          "properties": {
            "alternatives_min": {
              "type": "integer",
              "minimum": 1
            },
            "required_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "seeded_reviewer_defects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "threshold_profile": {
      "const": "release-26.10"
    }
  }
}
