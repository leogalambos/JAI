{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.1/review-record.schema.json",
  "title": "ReviewRecord",
  "type": "object",
  "required": [
    "id",
    "object_ref",
    "object_hash",
    "jai_layer",
    "recorded_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "object_ref": {
      "type": "string"
    },
    "object_hash": {
      "type": "string"
    },
    "jai_layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "recorded_at": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
