{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.3/workflow.schema.json",
  "title": "Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "title",
    "trigger",
    "outcome",
    "steps"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "trigger": {
      "type": "string",
      "minLength": 10
    },
    "outcome": {
      "type": "string",
      "minLength": 10
    },
    "mandatory_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "role",
          "slug",
          "skill",
          "tool_tier",
          "operator_agent",
          "does",
          "hands_over",
          "gate"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 2
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^it-roles-"
              },
              {
                "enum": [
                  "agent",
                  "dynamic",
                  "external"
                ]
              }
            ]
          },
          "tool_tier": {
            "enum": [
              "advise",
              "author",
              "execute",
              "inspect"
            ]
          },
          "operator_agent": {
            "type": "string",
            "minLength": 1
          },
          "does": {
            "type": "string",
            "minLength": 3
          },
          "hands_over": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 3
          },
          "mandatory_artifact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^skills/it-role-workflows/references/.+\\.md$"
    }
  }
}
