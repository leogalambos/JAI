{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.3/artifact-contract.schema.json",
  "title": "AI IT House Artifact Contract v3 — Native JAI Enforcement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "role_slug",
    "deliverable_number",
    "source_fingerprint",
    "jai",
    "lifecycle",
    "traceability",
    "compatibility"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "const": "3.0.0"
    },
    "role_slug": {
      "type": "string"
    },
    "deliverable_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "intent",
        "semantics",
        "justification",
        "design",
        "realisation",
        "evidence"
      ],
      "properties": {
        "core_version": {
          "const": "1.0.0"
        },
        "intent": {
          "type": "object",
          "required": [
            "purpose",
            "audience",
            "decision_supported",
            "owner_role",
            "classification"
          ]
        },
        "semantics": {
          "type": "object",
          "required": [
            "artifact_type",
            "schema_ref",
            "required_inputs",
            "required_relations"
          ]
        },
        "justification": {
          "type": "object",
          "required": [
            "required_evidence",
            "acceptance_profile",
            "evidence_profile",
            "reviewers",
            "approver",
            "semantic_policy",
            "repository_policy"
          ]
        },
        "design": {
          "type": "object",
          "required": [
            "mandatory_sections",
            "publication_profile"
          ]
        },
        "realisation": {
          "type": "object",
          "required": [
            "producer",
            "renderer",
            "output_formats",
            "system_of_record",
            "external_handoff_adapter",
            "production_mode"
          ]
        },
        "evidence": {
          "type": "object",
          "required": [
            "obligations",
            "publication_gate",
            "portfolio_traceability"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "review_cycle",
        "version",
        "retention"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "review_cycle": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "3.0.0"
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "downstream"
      ],
      "properties": {
        "upstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "writes",
        "migration",
        "classification_source"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "writes": {
          "const": "26.10.3/ArtifactContract-v3"
        },
        "migration": {
          "const": "forward-only"
        },
        "classification_source": {
          "type": "string",
          "pattern": "^explicit-ga-[0-9]{2}\\.(0[1-9]|1[0-2])\\.[0-9]+$"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_release",
        "source_schema",
        "source_id",
        "source_hash",
        "migration_version"
      ],
      "properties": {
        "source_release": {
          "type": "string",
          "minLength": 1
        },
        "source_schema": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "migration_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
