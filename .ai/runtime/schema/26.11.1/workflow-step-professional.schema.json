{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "role",
    "slug",
    "skill",
    "tool_tier",
    "operator_agent",
    "does",
    "hands_over",
    "gate"
  ],
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "minLength": 2
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^it-roles-"
        },
        {
          "enum": [
            "agent",
            "dynamic",
            "external"
          ]
        }
      ]
    },
    "tool_tier": {
      "enum": [
        "advise",
        "author",
        "execute",
        "inspect"
      ]
    },
    "operator_agent": {
      "type": "string",
      "minLength": 1
    },
    "does": {
      "type": "string",
      "minLength": 3
    },
    "hands_over": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string",
      "minLength": 3
    },
    "mandatory_artifact": {
      "type": "string",
      "minLength": 1
    },
    "handoff_content_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "basis",
        "subject",
        "workflow_profile_hash",
        "units"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "workflow_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "semantic_field",
              "required_fields",
              "acceptance_criterion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "semantic_field": {
                "type": "string",
                "minLength": 1
              },
              "required_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "acceptance_criterion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "variant_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_ids",
          "producer_role",
          "receiving_role",
          "acceptance_criterion",
          "handoff_content_contract",
          "next_step"
        ],
        "properties": {
          "contract_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "producer_role": {
            "type": "string",
            "minLength": 1
          },
          "receiving_role": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criterion": {
            "type": "string",
            "minLength": 1
          },
          "handoff_content_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "basis",
              "subject",
              "workflow_profile_hash",
              "units"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "const": "1.0.0"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "workflow_profile_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "semantic_field",
                    "required_fields",
                    "acceptance_criterion"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "semantic_field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required_fields": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "acceptance_criterion": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "next_step": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.11.1/workflow-step-professional.schema.json",
  "title": "Workflow step with exact professional handoff content"
}
