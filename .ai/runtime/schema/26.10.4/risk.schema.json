{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/risk.schema.json",
  "title": "Risk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "owner",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "treated",
        "accepted",
        "closed"
      ]
    },
    "likelihood": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "impact": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "treatment": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
