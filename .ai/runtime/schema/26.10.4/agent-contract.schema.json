{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/agent-contract.schema.json",
  "title": "AgentContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "purpose",
    "provider",
    "authority_boundary",
    "workload_class",
    "skills",
    "permissions",
    "allowed_tools",
    "denied_tools",
    "sandbox",
    "mutation_allowed",
    "audit_level",
    "jai"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "provider-neutral",
        "claude",
        "codex"
      ]
    },
    "authority_boundary": {
      "enum": [
        "read-only-review",
        "write-authoring",
        "orchestration",
        "release"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "shell",
        "network",
        "git",
        "mcp"
      ],
      "properties": {
        "filesystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "git": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "denied_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "workspace_write"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read-only",
            "workspace-write",
            "isolated-write"
          ]
        },
        "workspace_write": {
          "type": "boolean"
        },
        "network": {
          "enum": [
            "deny",
            "allowlisted",
            "provider-managed"
          ]
        }
      }
    },
    "mutation_allowed": {
      "type": "boolean"
    },
    "escalation": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_required_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_level": {
      "enum": [
        "standard",
        "high",
        "immutable"
      ]
    },
    "workload_class": {
      "type": "string",
      "minLength": 1
    },
    "jai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "layer",
        "layer_name",
        "profile",
        "responsibility",
        "input_refs",
        "output_refs",
        "authority_ref",
        "acceptance_question"
      ],
      "properties": {
        "core_version": {
          "const": "1.0.0"
        },
        "layer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "layer_name": {
          "enum": [
            "Intent and Context",
            "Meaning and Domain Model",
            "Reasoning, Policy and Control",
            "Solution Design",
            "Realisation and Tooling",
            "Execution and Evidence"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_question": {
          "type": "string",
          "minLength": 1
        },
        "evidence_obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_layer",
            "to_layer",
            "contract_ref"
          ],
          "properties": {
            "from_layer": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 6
            },
            "to_layer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "contract_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
