{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/layer-contract.schema.json",
  "title": "LayerContract",
  "type": "object",
  "required": [
    "id",
    "layer",
    "inputs",
    "outputs",
    "acceptance_question",
    "authority_ref"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_question": {
      "type": "string"
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
