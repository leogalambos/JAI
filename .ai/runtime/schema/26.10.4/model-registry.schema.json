{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/model-registry.schema.json",
  "title": "ModelRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "release",
    "fallback_class",
    "configuration",
    "workload_classes",
    "providers"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "fallback_class": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "override_file_default",
        "override_environment",
        "principle"
      ],
      "properties": {
        "override_file_default": {
          "type": "string",
          "minLength": 1
        },
        "override_environment": {
          "type": "string",
          "minLength": 1
        },
        "principle": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "complexity_order",
          "description",
          "reasoning_profile"
        ],
        "properties": {
          "complexity_order": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_profile": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "adapter",
          "selection_strategy",
          "classes",
          "strategy_scope"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "selection_strategy": {
            "type": "string",
            "minLength": 1
          },
          "classes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_selector"
              ],
              "properties": {
                "model_selector": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_effort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "model_selector"
                    ],
                    "properties": {
                      "model_selector": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reasoning_effort": {
                        "enum": [
                          "none",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max",
                          "ultra"
                        ]
                      }
                    }
                  }
                },
                "model_kind": {
                  "enum": [
                    "ai",
                    "deterministic"
                  ],
                  "description": "Explicit capability declaration for a process executor; native AI cannot be relabeled."
                },
                "model_provider": {
                  "enum": [
                    "codex",
                    "claude"
                  ],
                  "description": "Actual requested backend provider for declared process-wrapped AI."
                },
                "model_identity": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Actual requested backend model for declared process-wrapped AI, distinct from model_selector resource label."
                },
                "execution": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "argv",
                    "files"
                  ],
                  "properties": {
                    "provider": {
                      "const": "json-process/1"
                    },
                    "argv": {
                      "type": "array",
                      "minItems": 1,
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^/"
                        }
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "sha256"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "native_controls": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "strategy_scope": {
            "enum": [
              "project-internal"
            ]
          }
        }
      }
    },
    "execution_profile": {
      "type": "object",
      "description": "Pinned operational preferences; not authority or a catalogue restriction.",
      "properties": {
        "routing_mode": {
          "enum": [
            "workload",
            "profile"
          ],
          "description": "Explicit operational routing. Absent in legacy snapshots, whose configured flag retains its original meaning."
        }
      }
    },
    "professional_review_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "author_categories",
          "author_operators",
          "source_contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "different-model"
          },
          "author_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "author_operators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_contract": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
