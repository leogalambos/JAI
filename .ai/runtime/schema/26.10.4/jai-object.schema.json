{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/jai-object.schema.json",
  "title": "JAIObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object_type",
    "version",
    "jai"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "logical_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^lifecycle:.+$"
    },
    "object_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jai": {
      "$ref": "jai-layer-binding.schema.json"
    },
    "payload": {
      "type": "object"
    }
  },
  "dependentRequired": {
    "version_id": ["logical_id", "object_ref", "object_hash", "contract_ref", "context_digest"],
    "object_ref": ["version_id"],
    "object_hash": ["version_id"]
  }
}
