{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-it-house.local/schema/26.10.4/service-levels.schema.json",
  "title": "ServiceLevels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_levels_version",
    "release",
    "product_mode",
    "scope",
    "slos",
    "reference_sla",
    "error_budget_policy"
  ],
  "properties": {
    "service_levels_version": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "product_mode": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "target",
          "measurement",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "measurement": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reference_sla": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractual",
        "statement",
        "response_targets"
      ],
      "properties": {
        "contractual": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "response_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "priority",
              "condition",
              "acknowledgement",
              "containment_or_plan"
            ],
            "properties": {
              "priority": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "acknowledgement": {
                "type": "string",
                "minLength": 1
              },
              "containment_or_plan": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "error_budget_policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
