  "enforcement": {
    "tool_types": "agent frontmatter `tools`",
    "paths": "guard_library_write.py, from the install manifest, for the package's own files; settings.json Edit/Read deny rules for records, the key and settings.json itself",
    "approval": "hooks/guard_library_write.py + scripts/approve_change.py",
    "primary": "git branch protection with check_agent_policy.py as a required CI check",
    "caveat": "write_scope above is declarative. Tool permissions constrain types, not targets, so scope is enforced by the hooks and deny rules, not by the agent definition."
  },
  "separation_of_duties": {
    "library": [
      "library-author drafts into staging",
      "library-approver reviews and holds no Write",
      "a human records approval outside the agent layer",
      "library-release applies and consumes the record"
    ],
    "documentation": [
      "docs-author writes the documentation tree only",
      "source-docs-engineer edits source files and is bound by code review, not by permissions"
    ],
    "publication": [
      "owning specialist produces or approves the semantic source",
      "evidence-rationale-reviewer verifies claims, evidence, assumptions and rationale and holds no general Write",
      "enterprise-publication-editor may transform presentation but must preserve the semantic hash and may not invent claims or decisions",
      "visual-quality-reviewer reviews rendered outputs and holds no general Write",
      "named business/architecture/risk authority approves release where required"
    ]
  },
  "guarded_categories": [
    "it-roles-offensive-security-and-adversarial-testing"
  ],
  "skill_tier_counts": {
    "advise": 59,
    "author": 110,
    "execute": 93,
    "inspect": 3
  },
  "invariants": [
    "Every skill declares allowed-tools; nothing inherits the full tool surface.",
    "An agent's tools must be a subset of the tier it is bound to.",
    "An advise-tier skill must never be operated by an agent holding Write, Edit or Bash.",
    "Every skill in a guarded category must be route or advise tier and cleared by engagement-authorisation-guard.",
    "No agent both drafts and approves a library change.",
    "Writes into the live library require a current, scoped, human-recorded approval.",
    "docs-author may not write source files; source-docs-engineer may not change behaviour."
  ]
}
