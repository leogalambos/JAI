{
  "name": "sabsa-reviewer",
  "provider": "codex",
  "jai": {
    "core_version": "1.0.0",
    "layer": 3,
    "layer_name": "Reasoning, Policy and Control",
    "profile": "runtime",
    "responsibility": "sabsa-reviewer authority boundary",
    "input_refs": [
      "policy:managed-policy"
    ],
    "output_refs": [
      "execution:agent:sabsa-reviewer"
    ],
    "authority_ref": "human-authority:read-only-review",
    "acceptance_question": "Are decisions, policy constraints, evidence obligations, trade-offs and escalation rules justified?",
    "evidence_obligations": [
      "ExecutionRecord"
    ]
  },
  "workload_class": "standard",
  "selection_strategy": "project-managed-explicit-class-routing",
  "strategy_scope": "project-internal",
  "model_selector": "gpt-6.1-sol",
  "content_profile_ref": "jai/profiles/content-profile.json",
  "runtime_boundary": {
    "scope": "GA_COMPATIBLE/2",
    "live_verified": false,
    "hardened_privileged_enabled": false,
    "protected_resources": "deny",
    "git_authority": "human",
    "enforcement": "effective-provider-sandbox-and-host"
  },
  "reasoning_effort": "medium",
  "fallbacks": [
    {
      "model_selector": "gpt-5.6-sol",
      "reasoning_effort": "medium"
    },
    {
      "model_selector": "inherit"
    }
  ],
  "local_execution": {
    "requires_effective_native_sandbox": true,
    "contract_is_host_enforcement": false,
    "reviewer_source_write": false,
    "qa_output": "only explicitly native-writable scratch; never widen source access",
    "shell_available": false,
    "host_mount_isolation_required": true,
    "limitation": "Native settings must actually be loaded; no live confinement claim"
  },
  "sandbox_mode": "read-only",
  "workspace_write": false,
  "network": false,
  "allowed_tools": [
    "Read",
    "Grep",
    "Glob"
  ],
  "denied_tools": [
    "Agent",
    "Bash",
    "Edit",
    "Shell",
    "WebFetch",
    "Write"
  ],
  "approval_required_for": [
    "policy-change",
    "release-approval"
  ],
  "native_codex": {
    "model": "gpt-6.1-sol",
    "model_reasoning_effort": "medium",
    "sandbox_mode": "read-only",
    "approval_policy": "on-request"
  }
}
