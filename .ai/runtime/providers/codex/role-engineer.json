{
  "name": "role-engineer",
  "provider": "codex",
  "jai": {
    "core_version": "1.0.0",
    "layer": 5,
    "layer_name": "Realisation and Tooling",
    "profile": "runtime",
    "responsibility": "Execute-tier engineering within authorized workspace and effective native sandbox",
    "input_refs": [
      "policy:managed-policy"
    ],
    "output_refs": [
      "execution:agent:role-engineer"
    ],
    "authority_ref": "human-authority:write-authoring",
    "acceptance_question": "Is the design implemented through permitted tools and bounded execution mechanisms?",
    "evidence_obligations": [
      "ExecutionRecord"
    ]
  },
  "workload_class": "standard",
  "selection_strategy": "project-managed-explicit-class-routing",
  "strategy_scope": "project-internal",
  "model_selector": "gpt-6.1-sol",
  "runtime_boundary": {
    "scope": "GA_COMPATIBLE/2",
    "live_verified": false,
    "hardened_privileged_enabled": false,
    "protected_resources": "deny",
    "git_authority": "human",
    "enforcement": "effective-provider-sandbox-and-host"
  },
  "reasoning_effort": "medium",
  "fallbacks": [
    {
      "model_selector": "gpt-5.6-sol",
      "reasoning_effort": "medium"
    },
    {
      "model_selector": "inherit"
    }
  ],
  "local_execution": {
    "requires_effective_native_sandbox": true,
    "contract_is_host_enforcement": false,
    "reviewer_source_write": false,
    "qa_output": "only explicitly native-writable scratch; never widen source access",
    "shell_available": true,
    "host_mount_isolation_required": true,
    "limitation": "Native settings must actually be loaded; no live confinement claim"
  },
  "sandbox_mode": "workspace-write",
  "workspace_write": true,
  "network": false,
  "allowed_tools": [
    "Read",
    "Grep",
    "Glob",
    "Write",
    "Edit",
    "Bash"
  ],
  "denied_tools": [
    "Agent",
    "WebFetch",
    "approval-self-grant",
    "policy-mutation"
  ],
  "approval_required_for": [
    "policy-change",
    "release-approval"
  ],
  "native_codex": {
    "model": "gpt-6.1-sol",
    "model_reasoning_effort": "medium",
    "sandbox_mode": "workspace-write",
    "approval_policy": "on-request"
  }
}
