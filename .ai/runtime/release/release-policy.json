{
  "release_policy_version": "2.0.0",
  "production": true,
  "first_production_release": "26.10.0",
  "version_scheme": "YY.MM.VV",
  "version_regex": "^[0-9]{2}\\.(0[1-9]|1[0-2])\\.[0-9]+$",
  "changelog_mode": "production-only",
  "pre_ga_versions_in_changelog": false,
  "required_gates": [
    "source-contracts",
    "local-offline-tests",
    "public-documentation",
    "archive-integrity"
  ],
  "required_release_files": [
    "VERSION",
    "CHANGELOG.md",
    "README.md",
    "install.sh",
    "requirements.txt",
    "RELEASE-SCOPE.json"
  ],
  "signing": {
    "mode": "automated-ci-release",
    "private_key_in_package": false,
    "publication_requires_manual_approval": false,
    "attestation": "github-oidc-if-supported"
  }
}
