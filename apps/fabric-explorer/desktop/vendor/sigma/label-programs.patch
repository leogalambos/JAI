+import type { Settings } from "../settings";
+import { hasAnyEnabled } from "./label-events";
+/** Reject label dependencies before allocation or settings publication when companions are omitted. */
+export function assertNodeLabelPrograms(enabled: boolean, settings: Settings, attachments: object | undefined): void {
+  if (!enabled && (settings.renderLabels || hasAnyEnabled(settings.nodeLabelEvents) || Object.keys(attachments ?? {}).length)) {
+    throw new Error("Sigma: labelPrograms:false requires renderLabels:false, disabled nodeLabelEvents and no labelAttachments");
+  }
+}
