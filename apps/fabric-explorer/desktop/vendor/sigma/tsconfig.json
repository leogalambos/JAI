{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".cache/dist/types",
    "rootDir": ".cache/upstream/src",
    "types": [
      "node"
    ],
    "paths": {
      "sigma": [
        "./.cache/upstream/src/index.ts"
      ],
      "sigma/*": [
        "./.cache/upstream/src/*"
      ]
    }
  },
  "include": [
    ".cache/upstream/src/**/*.ts"
  ],
  "exclude": [
    ".cache/upstream/src/**/*.test.ts",
    ".cache/upstream/src/**/*.test-d.ts"
  ]
}
